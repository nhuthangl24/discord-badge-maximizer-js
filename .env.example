# Discord Badge Maximizer (Node.js) - Configuration Template
# Copy this file to .env:
# cp .env.example .env

# ==========================================
# 1. DISCORD APPLICATION BOT TOKEN (Required if running bot.js)
# ==========================================
# Create a bot at https://discord.com/developers/applications
# Copy its Token and paste here:
DISCORD_BOT_TOKEN=

# ==========================================
# 2. ALT ACCOUNT USER CREDENTIALS (Optional - can be configured in Discord /setup)
# ==========================================
DISCORD_TOKEN=
DISCORD_COOKIE=
DISCORD_VIEWER_TOKEN=

# ==========================================
# 3. DEFAULT VOICE CHANNEL & GUILD (Optional)
# ==========================================
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# ==========================================
# 4. ADMIN USER IDS (Optional - comma separated)
# ==========================================
ADMIN_IDS=707934327467671643
